<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>dynamicfeed_msgs</name>
  <version>0.1.0</version>
  <description>Message interface for Dynamic Feed signed situational awareness on ROS 2 (DF-VERIFY/1): Provenance trust envelope, HazardAlert, GpsInterference, AirQuality, SpaceWeather.</description>
  <maintainer email="hello@dynamicfeed.ai">Dynamic Feed</maintainer>
  <license>MIT</license>
  <url type="website">https://dynamicfeed.ai/standard</url>
  <url type="repository">https://github.com/dynamicfeed/dynamicfeed-ros</url>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <depend>std_msgs</depend>
  <depend>geographic_msgs</depend>
  <depend>builtin_interfaces</depend>

  <exec_depend>rosidl_default_runtime</exec_depend>
  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
