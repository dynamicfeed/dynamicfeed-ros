<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>dynamicfeed_awareness</name>
  <version>0.1.0</version>
  <description>ROS 2 node publishing Dynamic Feed signed situational awareness (weather, hazards, GPS interference, air quality, space weather) as standard ROS topics, verifying the Ed25519 signature on the robot. Keyless. DF-VERIFY/1.</description>
  <maintainer email="hello@dynamicfeed.ai">Dynamic Feed</maintainer>
  <license>MIT</license>
  <url type="website">https://dynamicfeed.ai/standard</url>
  <url type="repository">https://github.com/dynamicfeed/dynamicfeed-ros</url>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>geographic_msgs</exec_depend>
  <exec_depend>diagnostic_msgs</exec_depend>
  <exec_depend>dynamicfeed_msgs</exec_depend>
  <exec_depend>python3-cryptography</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
